extends Node

signal inventory_changed
signal slot_selected(slot_index: int) # hotbar slot selected
signal backpack_slot_selected(slot_index: int) # backpack slot selected

var selected_slot_index := 0
var selected_backpack_index := 0

class Slot:
	var item: ItemData
	var count: int = 0

	func __init__(i: ItemData = null, c: int = 0):
		item = i
		count = c

const HOTBAR_SIZE := 4
const BACKPACK_SIZE := 32 # increased backpack size
var hotbar: Array[Slot]
var backpack: Array[Slot]

func _init() -> void:
	hotbar.resize(HOTBAR_SIZE)
	backpack.resize(BACKPACK_SIZE)
	for i in HOTBAR_SIZE:
		hotbar[i] = Slot.new()
	for i in BACKPACK_SIZE:
		backpack[i] = Slot.new()

func add_item(item: ItemData, amount: int = 1) -> bool:
	# Try to stack first in hotbar
	for slot in hotbar:
		if slot.item == item:
			slot.count += amount
			inventory_changed.emit()
			return true
	# Then in backpack
	for slot in backpack:
		if slot.item == item:
			slot.count += amount
			inventory_changed.emit()
			return true

	# Try to find empty slot in hotbar
	for i in HOTBAR_SIZE:
		if hotbar[i].item == null:
			hotbar[i].item = item
			hotbar[i].count = amount
			inventory_changed.emit()
			if i < HOTBAR_SIZE:  # hotbar slot
				slot_selected.emit(i)
			return true
	# Then in backpack
	for i in BACKPACK_SIZE:
		if backpack[i].item == null:
			backpack[i].item = item
			backpack[i].count = amount
			inventory_changed.emit()
			# No slot_selected for backpack
			return true
	return false

func drop_item(index: int, from_hotbar: bool = true) -> ItemData:
	if from_hotbar:
		if index < 0 or index >= HOTBAR_SIZE:
			return null
		slot = hotbar[index]
	else:
		if index < 0 or index >= BACKPACK_SIZE:
			return null
		slot = backpack[index]
	if slot.item == null:
		return null

	var item_to_drop = slot.item
	slot.count -= 1

	if slot.count <= 0:
		slot.item = null
		slot.count = 0

	inventory_changed.emit()
	return item_to_drop

func select_hotbar_slot(index: int):
	selected_slot_index = clamp(index, 0, HOTBAR_SIZE - 1)
	slot_selected.emit(selected_slot_index)

func select_backpack_slot(index: int):
	selected_backpack_index = clamp(index, 0, BACKPACK_SIZE - 1)
	backpack_slot_selected.emit(selected_backpack_index)

func swap_slots(from_hotbar: bool, from_index: int, to_hotbar: bool, to_index: int) -> bool:
	# Validate indices
	var from_slot: Slot
	var to_slot: Slot
	if from_hotbar:
		if from_index < 0 or from_index >= HOTBAR_SIZE:
			return false
		from_slot = hotbar[from_index]
	else:
		if from_index < 0 or from_index >= BACKPACK_SIZE:
			return false
		from_slot = backpack[from_index]
	if to_hotbar:
		if to_index < 0 or to_index >= HOTBAR_SIZE:
			return false
		to_slot = hotbar[to_index]
	else:
		if to_index < 0 or to_index >= BACKPACK_SIZE:
			return false
		to_slot = backpack[to_index]
	# Swap
	var temp_item = from_slot.item
	var temp_count = from_slot.count
	from_slot.item = to_slot.item
	from_slot.count = to_slot.count
	to_slot.item = temp_item
	to_slot.count = temp_count
	inventory_changed.emit()
	# Emit selection signals if needed?
	return true

# test comment to force change